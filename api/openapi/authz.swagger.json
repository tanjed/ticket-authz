            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/InternalServiceCheckAssignableBody"
            }
          }
        ],
        "tags": [
          "InternalService"
        ]
      }
    },
