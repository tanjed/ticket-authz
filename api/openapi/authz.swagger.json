{
  "swagger": "2.0",
  "info": {
    "title": "bus/authz/v1/types.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AdminService",
      "description": "AdminService is the company admin API, served on the public listeners (REST :8080, gRPC :9090).\nOnly the APISIX gateway can reach them: it has verified the caller's token and the route's\npermission, and passes the caller as x-bus-subject, x-bus-company-id and x-bus-user-type\n(HTTP headers, or gRPC metadata). Every call is scoped to the caller's company and checked\nagainst the escalation rule: nobody hands out permissions they do not hold."
    },
    {
      "name": "HealthService",
      "description": "HealthService is the kubelet's probes, served on both listeners (the chart probes the internal\none)."
    },
    {
      "name": "InternalService",
      "description": "InternalService is for callers inside the cluster: services' seed Jobs, the IdP, platform\noperations. Served on the internal listeners (REST :8081, gRPC :9091), which the gateway never\nroutes. It has no authentication: the network is the boundary."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/internal/v1/companies/{company_id}/admin": {
      "post": {
        "summary": "Creates the company's protected Admin role if it has none, makes user_id hold it, and\npublishes company active, role `*` and the user's version. Idempotent: an existing protected\nrole is reused and the holding ensured. Called by Company on company creation.",
        "operationId": "InternalService_CreateAdminRole",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateAdminRoleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "company_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/InternalServiceCreateAdminRoleBody"
            }
          }
        ],
        "tags": [
          "InternalService"
        ]
      }
    },
    "/internal/v1/companies/{company_id}/assignable": {
      "post": {
        "summary": "The escalation rule for an invitation: every role must belong to the company and the caller's\nown permissions (read fresh) must cover them. PERMISSION_DENIED (escalation) or NOT_FOUND.",
