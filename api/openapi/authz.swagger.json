{
  "swagger": "2.0",
  "info": {
    "title": "bus/authz/v1/types.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AdminService",
      "description": "AdminService is the company admin API, served on the public listeners (REST :8080, gRPC :9090).\nOnly the APISIX gateway can reach them: it has verified the caller's token and the route's\npermission, and passes the caller as x-bus-subject, x-bus-company-id and x-bus-user-type\n(HTTP headers, or gRPC metadata). Every call is scoped to the caller's company and checked\nagainst the escalation rule: nobody hands out permissions they do not hold."
    },
    {
      "name": "BundleService",
      "description": "BundleService shows the signed OPA bundles to operators and tools. OPA itself downloads them\nfrom GET /bundles/{name}.tar.gz (ETag, long polling and 304 Not Modified: a protocol an RPC\ncannot speak). Served on the internal listener only."
    },
    {
      "name": "HealthService",
      "description": "HealthService is the kubelet's probes, served on both listeners (the chart probes the internal\none)."
    },
    {
      "name": "InternalService",
      "description": "InternalService is for callers inside the cluster: services' seed Jobs, the IdP, platform\noperations. Served on the internal listeners (REST :8081, gRPC :9091), which the gateway never\nroutes. It has no authentication: the network is the boundary."
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
