{
  "permissions": [
    { "key": "role:read", "description": "View the company's roles and the permission catalogue" },
    { "key": "role:manage", "description": "Create, edit and delete the company's roles" },
    { "key": "member:manage", "description": "Change the roles of the company's users" }
  ],
  "routes": [
    { "name": "authz.permissions.list", "permission": "role:read" },
    { "name": "authz.roles.list", "permission": "role:read" },
    { "name": "authz.roles.get", "permission": "role:read" },
    { "name": "authz.roles.create", "permission": "role:manage" },
    { "name": "authz.roles.update", "permission": "role:manage" },
    { "name": "authz.roles.delete", "permission": "role:manage" },
    { "name": "authz.users.roles", "permission": "role:read" },
    { "name": "authz.members.roles", "permission": "member:manage" },
    { "name": "authz.me", "authenticated": true }
  ]
}
